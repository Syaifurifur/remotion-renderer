            {
              "id": "cond-approve",
              "leftValue": "={{ $json.mode === 'callback' && $json.action === 'approve' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-approve",
      "name": "Is Approve Callback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -640,
        400
