              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jobId\": \"{{ $('Parse Gemini JSON').item.json.jobId }}\",\n  \"title\": \"{{ $('Parse Gemini JSON').item.json.title }}\",\n  \"caption\": \"{{ $('Parse Gemini JSON').item.json.caption }}\",\n  \"themeColor\": \"{{ $('Parse Gemini JSON').item.json.themeColor }}\",\n  \"scenes\": {{ JSON.stringify($('Parse Gemini JSON').item.json.scenes) }},\n  \"audioBase64\": \"{{ $json.candidates[0].content.parts[0].inlineData.data }}\",\n  \"audioMimeType\": \"{{ $json.candidates[0].content.parts[0].inlineData.mimeType || 'audio/L16;rate=24000' }}\"\n}",
        "options": {
          "timeout": 300000
        }
