      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        -1120,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst allowedChatId = ''; // OPSIONAL: Isi Chat ID Telegram Anda (string) untuk mengunci akses bot\n\nif (input.callback_query) {\n  const cb = input.callback_query;\n  const chatId = String(cb.message.chat.id);\n  if (allowedChatId && chatId !== allowedChatId) return [];\n  const [action, jobId] = String(cb.data || '').split('|');\n  return [{\n    json: {\n      mode: 'callback',\n      action,\n      jobId,\n      chatId,\n      callbackQueryId: cb.id,\n      messageId: cb.message.message_id\n    }\n  }];\n}\n\nconst msg = input.message;\nif (!msg || !msg.text) return [];\nconst chatId = String(msg.chat.id);\nif (allowedChatId && chatId !== allowedChatId) return [];\n\nconst text = msg.text.trim();\nif (!text.startsWith('/video')) {\n  return [{\n    json: {\n      mode: 'help',\n      chatId\n    }\n  }];\n}\n\nconst topic = text.replace(/^\\/video\\s*/i, '').trim();\nif (!topic) {\n  return [{\n    json: {\n      mode: 'help',\n      chatId\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    mode: 'generate',\n    chatId,\n    topic,\n    jobId: `job_${Date.now()}`\n  }\n}];"
      },
      "id": "route-command",
      "name": "Route Telegram Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        240
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-generate",
              "leftValue": "={{ $json.mode }}",
              "rightValue": "generate",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-generate",
      "name": "Is /video Command?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        -640,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
