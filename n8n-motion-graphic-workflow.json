    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "=â³ Sedang membuat skrip, voiceover Gemini TTS, dan render video motion graphic untuk topik:\n\"{{ $json.topic }}\"",
        "additionalFields": {}
      },
      "id": "tg-notify-start",
      "name": "Telegram Notify Start",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        -380,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=YOUR_GEMINI_API_KEY",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Kamu adalah Motion Graphic Scriptwriter profesional untuk video vertikal 9:16 (YouTube Shorts & Instagram Reels) berdurasi 25-35 detik dalam bahasa Indonesia.\\n\\nTopik: {{ $('Route Telegram Command').item.json.topic }}\\n\\nBuat output JSON VALID (tanpa markdown) dengan struktur persis berikut:\\n{\\n  \\\"title\\\": \\\"Judul singkat menarik max 70 karakter\\\",\\n  \\\"caption\\\": \\\"Caption IG Reels & deskripsi YouTube Shorts lengkap dengan hashtag relevan termasuk #Shorts\\\",\\n  \\\"narration\\\": \\\"Teks narasi utuh yang enak dibacakan voiceover dalam 25-35 detik, tanpa simbol aneh\\\",\\n  \\\"themeColor\\\": \\\"#0b63ce\\\",\\n  \\\"scenes\\\": [\\n    {\\n      \\\"headline\\\": \\\"Teks besar 3-5 kata\\\",\\n      \\\"subtext\\\": \\\"Penjelasan singkat max 12 kata\\\",\\n      \\\"badge\\\": \\\"HOOK / POIN 1 / CTA\\\",\\n      \\\"durationSec\\\": 5\\n    }\\n  ]\\n}\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\"\n  }\n}",
        "options": {}
      },
      "id": "gemini-script",
      "name": "Gemini Generate Script & Scenes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -120,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\nconst parsed = JSON.parse(raw);\nconst route = $('Route Telegram Command').item.json;\n\nreturn [{\n  json: {\n    jobId: route.jobId,\n    chatId: route.chatId,\n    topic: route.topic,\n    title: parsed.title || route.topic.slice(0, 70),\n    caption: parsed.caption || `${route.topic} #Shorts`,\n    narration: parsed.narration || route.topic,\n    themeColor: parsed.themeColor || '#0b63ce',\n    scenes: Array.isArray(parsed.scenes) ? parsed.scenes : []\n  }\n}];"
      },
      "id": "parse-script",
      "name": "Parse Gemini JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        120,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=YOUR_GEMINI_API_KEY",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"Bacakan dengan intonasi energik, jelas, dan natural untuk video pendek edukasi: {{ $json.narration }}\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseModalities\": [\"AUDIO\"],\n    \"speechConfig\": {\n      \"voiceConfig\": {\n        \"prebuiltVoiceConfig\": {\n          \"voiceName\": \"Kore\"\n        }\n      }\n    }\n  }\n}",
        "options": {}
      },
